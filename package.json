{
  "name": "customer-inquiry-management-system",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace=@inquiry/api\" \"npm run dev --workspace=@inquiry/web\"",
    "dev:api": "npm run dev --workspace=@inquiry/api",
    "dev:web": "npm run dev --workspace=@inquiry/web",
    "build": "npm run build --workspace=@inquiry/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
