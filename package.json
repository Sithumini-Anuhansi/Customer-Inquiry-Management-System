{
  "name": "customer-inquiry-management-system",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace=@inquiry/api\" \"npm run dev --workspace=@inquiry/web\"",
    "dev:api": "npm run dev --workspace=@inquiry/api",
    "dev:web": "npm run dev --workspace=@inquiry/web",
    "db:migrate": "npm run db:migrate --workspace=@inquiry/api",
    "db:seed": "npm run db:seed --workspace=@inquiry/api",
    "db:seed:inquiries": "npm run db:seed:inquiries --workspace=@inquiry/api",
    "build": "npm run build --workspace=@inquiry/web",
    "test": "npm run test --workspace=@inquiry/api && npm run test --workspace=@inquiry/web",
    "test:integration": "npm run test:integration --workspace=@inquiry/api",
    "test:e2e": "npm run test:e2e --workspace=@inquiry/web"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^4.1.11"
  }
}
